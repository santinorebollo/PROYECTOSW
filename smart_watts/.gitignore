# ===============================================
# .gitignore
# ===============================================
# Archivos a ignorar en Git
# ===============================================

# ==================== ENTORNO ====================
.env
.env.local
.venv
venv/
ENV/
env/

# ==================== IDE ====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
.sublime-project
.sublime-workspace

# ==================== PYTHON ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==================== DATABASE ====================
database/*.db
database/*.sqlite
database/*.sqlite3
*.db-journal

# ==================== LOGS ====================
logs/
*.log

# ==================== TESTING ====================
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ==================== ARCHIVOS TEMPORALES ====================
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
.~*

# ==================== OS ====================
Thumbs.db
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# ==================== NODE ====================
node_modules/
npm-debug.log
yarn-error.log

# ==================== CONFIGURACIÓN SENSIBLE ====================
config.local.py
secrets.json
.credentials/
*.pem
*.key

# ==================== ARCHIVOS GENERADOS ====================
instance/
.webassets-cache
.scrapy
docs/_build/
site/

# ==================== ARCHIVOS DE SISTEMA ====================
.venv
.env
.enrc
.envrc
