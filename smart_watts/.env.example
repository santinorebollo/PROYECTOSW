# ===============================================
# .env.example
# ===============================================
# Archivo de ejemplo de variables de entorno
#
# Copiar a .env y completar con valores reales:
#     cp .env.example .env
# ===============================================

# ==================== ENTORNO ====================
FLASK_ENV=development
FLASK_APP=run.py

# ==================== SEGURIDAD ====================
SECRET_KEY=tu-clave-secreta-muy-segura-aqui

# ==================== BASE DE DATOS ====================
# Para SQLite (desarrollo)
DATABASE_URL=sqlite:///database/smart_watts.db

# Para MySQL (producción)
# DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost/smart_watts

# Para PostgreSQL (producción)
# DATABASE_URL=postgresql://usuario:contraseña@localhost/smart_watts

# ==================== SERVIDOR ====================
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# ==================== EMAIL (OPCIONAL) ====================
# Para recuperación de contraseña
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-contraseña

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=logs/smart_watts.log

# ==================== SOCKET.IO ====================
SOCKETIO_MESSAGE_QUEUE=None
# Para producción con Redis:
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379

# ==================== API ====================
# Token de API para integraciones externas
API_SECRET_KEY=tu-clave-api-secreta

# ==================== CONFIGURACIÓN DE NEGOCIO ====================
DEFAULT_CURRENCY=ARS
DEFAULT_BUDGET=5000
DEFAULT_CONSUMPTION_LIMIT=500

# ==================== PRODUCCIÓN ====================
# Cambiar a True en producción
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
